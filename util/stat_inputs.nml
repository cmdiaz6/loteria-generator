&input_data
win_condition = 'any_four' ! any_four, corners, blackout
!win_condition = 'corners'  ! any_four, corners, blackout
!win_condition = 'blackout' ! any_four, corners, blackout
nboards       = 50         ! number of boards/players
ngames        = 100000     ! number of games to simulate 
ncards        = 54         ! number of cards (standard loteria deck is 54)
/

